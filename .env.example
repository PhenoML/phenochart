# PhenoML credentials are managed via the extension options page.
# Open chrome://extensions → PhenoChart → Options to enter your credentials.
#
# The variables below are no longer used at runtime. They are kept here as a
# reference for developers who want to explore env-based overrides in future.
#
# VITE_PHENOML_INSTANCE_URL=https://experiment.app.pheno.ml
# VITE_PHENOML_CLIENT_ID=
# VITE_PHENOML_CLIENT_SECRET=
