# PhenoML API Credentials
# Get these from your PhenoML account at https://developer.pheno.ml
# Used for real Construe API calls (V1+). V0 uses mocked data only.
PHENOML_CLIENT_ID=your_client_id_here
PHENOML_CLIENT_SECRET=your_client_secret_here
PHENOML_API_URL=https://experiment.app.pheno.ml

# MedPlum FHIR Server (V1+)
MEDPLUM_BASE_URL=http://localhost:3000
MEDPLUM_CLIENT_ID=your_medplum_client_id_here
